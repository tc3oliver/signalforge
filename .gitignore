*.log
.env
.omc/
backups/
fixtures/generated/
logs/
node_modules/
runs/

# Published briefs are output, not source: the database is canonical and
# these files are re-rendered from it by `pnpm daily`.
briefs/

# Credentials live in ~/.config/daily-intelligence/secrets.env, outside this
# repository, so this line is belt and braces: it only matters if someone ever
# copies that file in here, which is exactly when it would matter most.
secrets.env

# Operator configuration. Every config/*.yaml in the repository is a shipped
# default; the real one is *.local.yaml, wins outright when present, and is
# nobody else's business -- interests and watchlists in particular are as
# personal as a bookmarks file.
config/*.local.yaml

# Operational output directories. `observations/` does not exist yet and nothing
# writes it today; it is listed because it is the natural name for the next
# thing that records what a run saw, and a production artifact directory is far
# easier to ignore before it exists than after it has been committed once.
observations/
