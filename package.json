{
  "name": "signalforge",
  "version": "0.1.0",
  "description": "Self-hosted AI intelligence pipeline that turns noisy multi-source data into deduplicated events, emerging signals, and source-grounded daily briefs.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest --run",
    "test:integration": "DI_REQUIRE_INTEGRATION=1 vitest --run",
    "verify": "pnpm run typecheck && pnpm run phase1:generate && pnpm run test:integration && pnpm run build",
    "typecheck": "tsc --noEmit",
    "build": "pnpm run typecheck && pnpm --dir web run build",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:reset": "tsx --env-file-if-exists=.env src/db/migrate.ts --reset",
    "collect": "tsx --env-file-if-exists=.env src/cli/run-collection.ts",
    "daily": "tsx --env-file-if-exists=.env src/cli/run-daily.ts",
    "setup:check": "tsx --env-file-if-exists=.env src/cli/setup-check.ts",
    "demo": "tsx --env-file-if-exists=.env web/scripts/seed-dev.ts",
    "phase1:generate": "tsx src/cli/generate-fixtures.ts",
    "phase1:curate": "tsx src/cli/run-curator.ts",
    "phase1:edit": "tsx src/cli/run-editor.ts",
    "phase1:run": "tsx src/cli/run-phase1.ts",
    "eval:run": "tsx src/cli/run-eval.ts",
    "stability:run": "tsx src/cli/run-stability.ts",
    "benchmark:models": "tsx src/cli/benchmark.ts",
    "web:dev": "pnpm --dir web run dev",
    "web:build": "pnpm --dir web run build",
    "web:start": "pnpm --dir web run start",
    "web:seed": "tsx --env-file-if-exists=.env web/scripts/seed-dev.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "postgres": "^3.4.9",
    "typebox": "1.3.7",
    "yaml": "^2.9.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
