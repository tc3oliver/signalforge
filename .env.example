# Copy to .env and replace the placeholder password with a locally generated one.
# .env is gitignored; never commit a real credential.
POSTGRES_USER=daily_intelligence
POSTGRES_PASSWORD=replace-me-with-a-local-password
POSTGRES_DB=daily_intelligence
POSTGRES_PORT=55432

# The app reads DATABASE_URL first; PGHOST/PGPORT/... are the fallback.
DATABASE_URL=postgres://daily_intelligence:replace-me-with-a-local-password@127.0.0.1:55432/daily_intelligence

# Ledger namespace. Synthetic/experimental runs set their own value so they can
# never collide with production rows in the same database.
DI_LINEAGE=default
